{
  "name": "@usetaehwan/ui",
  "version": "0.2.0",
  "description": "A warm, token-based React design system",
  "license": "MIT",
  "author": "Taehwan Jeong",
  "repository": {
    "type": "git",
    "url": "https://github.com/JeongTaehwan/usetaehwan-ui"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "demo"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && cp src/tokens/tokens.css dist/tokens.css && cp src/tokens/styles.css dist/styles.css",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:dev": "npm run build && npm --workspace demo run dev",
    "demo:build": "npm run build && npm --workspace demo run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
